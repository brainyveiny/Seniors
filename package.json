{
  "name": "seniors-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev -H 127.0.0.1 --webpack",
    "build": "prisma generate && node scripts/build-seniors-framer-landing.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate && node scripts/copy-tinymce.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed-seniors": "node scripts/seed-seniors-demo.mjs",
    "db:seed-seniors-full": "node scripts/seed-seniors-full-panel.mjs",
    "db:seed-test-school": "node scripts/seed-seniors-test-school.mjs",
    "db:enrich-photosynthesis": "node scripts/enrich-photosynthesis-topic.mjs",
    "test:seniors": "node scripts/test-seniors-logic.mjs",
    "test:seniors:e2e": "node scripts/test-seniors-e2e-production.mjs",
    "build:seniors-landing": "node scripts/build-seniors-framer-landing.mjs",
    "fetch:framer-ssr": "node scripts/fetch-framer-ssr.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.0.0",
    "jose": "^6.2.3",
    "katex": "^0.17.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "pg-connection-string": "^2.13.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tinymce": "^8.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
