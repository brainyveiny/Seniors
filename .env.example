# Database (PostgreSQL). App runtime uses DATABASE_URL; Prisma CLI uses DIRECT_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seniors?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/seniors?schema=public"

# Long random secret for JWT session cookies
AUTH_SECRET="change-me"

# First Seniors product admin (/seniors/th-admin/login) -only used while no admin exists
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Public origin, e.g. https://seniors.example.com
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# Email OTP (Resend)
RESEND_API_KEY=
SENIORS_EMAIL_FROM="Seniors <noreply@example.com>"
EMAIL_REPLY_TO=

# SMS OTP (MSG91, optional)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_WIDGET_ID=
MSG91_WIDGET_AUTH_TOKEN=
# Show OTP in API responses (dev only)
SHOW_DEV_OTP=false

# AI doubt solver: gemini (default) | openai | ollama
SENIORS_AI_PROVIDER=gemini
SENIORS_AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_MODEL=

# Media storage -Cloudflare R2 (preferred) or Firebase Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
