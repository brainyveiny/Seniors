generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model PlatformSuperAdmin {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
}

model PlatformAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  tenantId   String?
  tenantSlug String   @default("")
  summary    String   @default("")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId, createdAt])
}

model Tenant {
  id               String   @id @default(cuid())
  slug             String   @unique
  subdomain        String   @default("")
  /// Client-owned hostname (e.g. www.myacademy.com) -unique when set
  customDomain     String?  @unique
  platformName     String   @default("Your Academy")
  ownerName        String   @default("")
  userType         String?
  brandColor       String   @default("indigo")
  teachingSubjects String[] @default([])
  initialized      Boolean  @default(false)
  /// When false, public storefront is hidden (admin panel still accessible).
  isPublished      Boolean  @default(true)
  activeTemplateId String?
  /// Product flags for multi-product tenants (e.g. academy, connect)
  enabledProducts        String[] @default(["academy"])
  /// "active" | "suspended" -suspended schools cannot log in or use any panel
  status           String   @default("active")
  suspendedReason  String   @default("")
  contactName      String   @default("")
  contactEmail     String   @default("")
  contactPhone     String   @default("")
  city             String   @default("")
  state            String   @default("")
  address          String   @default("") @db.Text
  /// Visible to platform super admins only
  internalNotes    String   @default("") @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users        PlatformUser[]
  seniorsAcademicYears    SeniorsAcademicYear[]
  seniorsClasses          SeniorsClass[]
  seniorsSubjects         SeniorsSubject[]
  seniorsChapters         SeniorsChapter[]
  seniorsTopics           SeniorsTopic[]
  seniorsTopicContents    SeniorsTopicContent[]
  seniorsAssignments      SeniorsAssignment[]
  seniorsQuizzes          SeniorsQuiz[]
  seniorsExams            SeniorsExam[]
  seniorsAnnouncements    SeniorsAnnouncement[]
  seniorsTopicProgress    SeniorsTopicProgress[]
  seniorsParentChildren   SeniorsParentChild[]
  seniorsSchoolSettings   SeniorsSchoolSettings?
  seniorsAnalyticsEvents  SeniorsAnalyticsEvent[]
  seniorsTeacherUpdates   SeniorsTeacherUpdate[]
  seniorsTeacherAssignments SeniorsTeacherAssignment[]
  seniorsJoinRequests     SeniorsJoinRequest[]
  seniorsMediaFiles       SeniorsMediaFile[]
  seniorsAiThreads        SeniorsAiThread[]
  seniorsGamification     SeniorsStudentGamification[]
  seniorsTimetableSlots   SeniorsTimetableSlot[]
  seniorsPersonalTimetableSlots SeniorsPersonalTimetableSlot[]
  seniorsAttendance       SeniorsAttendance[]
  seniorsLeaveRequests    SeniorsLeaveRequest[]
  seniorsFeeRecords       SeniorsFeeRecord[]
  seniorsTransportRoutes  SeniorsTransportRoute[]
  seniorsStudentTransport SeniorsStudentTransport[]
  seniorsTransportUpdateRequests SeniorsTransportUpdateRequest[]
  seniorsServiceCatalogs  SeniorsServiceCatalog[]
  seniorsServiceSelections SeniorsServiceSelection[]
}

model SeniorsAcademicYear {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label     String
  isActive  Boolean  @default(true)
  isArchived Boolean @default(false)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics   SeniorsTopic[]
  contents SeniorsTopicContent[]
  assignments SeniorsAssignment[]

  @@unique([tenantId, label])
  @@index([tenantId, isActive])
}

model SeniorsClass {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  section   String   @default("")
  board     String   @default("CBSE")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects SeniorsSubject[]
  students SeniorsStudentProfile[]
  teacherAssignments SeniorsTeacherAssignment[]
  assignments SeniorsAssignment[]
  exams SeniorsExam[]
  timetableSlots SeniorsTimetableSlot[]

  @@index([tenantId])
}

model SeniorsTeacherAssignment {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   PlatformUser @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String
  class     SeniorsClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   SeniorsSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teacherId, classId, subjectId])
  @@index([tenantId, teacherId])
  @@index([tenantId, classId])
}

model SeniorsStudentProfile {
  id        String   @id @default(cuid())
  tenantId  String
  classId   String
  class     SeniorsClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId String   @unique
  student   PlatformUser @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rollNumber String  @default("")
  createdAt DateTime @default(now())

  @@unique([tenantId, studentId])
  @@index([tenantId, classId])
}

model SeniorsJoinRequest {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role                String
  fullName            String
  email               String
  phone               String   @default("")
  passwordHash        String
  requestedClassLabel String   @default("")
  rollNumber          String   @default("")
  requestedSubject    String   @default("")
  status              String   @default("pending")
  rejectionReason     String   @default("") @db.Text
  reviewedById        String?
  reviewedAt          DateTime?
  approvedUserId      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([tenantId, role, status])
}

model SeniorsTimetableSlot {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId     String
  class       SeniorsClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  /// 1 = Monday … 7 = Sunday (ISO weekday)
  dayOfWeek   Int
  periodIndex Int
  startTime   String
  endTime     String
  subjectName String   @default("")
  teacherName String   @default("")
  room        String   @default("")
  isBreak     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([classId, dayOfWeek, periodIndex])
  @@index([tenantId, classId, dayOfWeek])
}

model SeniorsPersonalTimetableSlot {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId   String
  student     PlatformUser @relation(fields: [studentId], references: [id], onDelete: Cascade)
  /// 1 = Monday … 7 = Sunday
  dayOfWeek   Int
  periodIndex Int
  startTime   String
  endTime     String
  subjectName String   @default("")
  teacherName String   @default("")
  room        String   @default("")
  note        String   @default("")
  isBreak     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, dayOfWeek, startTime])
  @@index([tenantId, studentId, dayOfWeek])
}

model SeniorsSubject {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId   String
  class     SeniorsClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters SeniorsChapter[]
  teacherAssignments SeniorsTeacherAssignment[]

  @@index([tenantId, classId])
}

model SeniorsChapter {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjectId String
  subject   SeniorsSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  number    Int      @default(1)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics SeniorsTopic[]

  @@index([tenantId, subjectId])
}

model SeniorsTopic {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chapterId          String
  chapter            SeniorsChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  academicYearId     String
  academicYear       SeniorsAcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  slug               String
  number             String   @default("")
  title              String
  learningObjective  String   @default("") @db.Text
  teacherExplanation String   @default("") @db.Text
  keywords           String[] @default([])
  diagramUrl         String   @default("")
  diagrams           Json     @default("[]")
  contentStatus      String   @default("missing")
  sortOrder          Int      @default(0)
  markingScheme      String   @default("") @db.Text
  answerFormat       String   @default("") @db.Text
  revisionChecklist  String[] @default([])
  draftLearningObjective  String   @default("") @db.Text
  draftTeacherExplanation String   @default("") @db.Text
  draftKeywords           String[] @default([])
  draftDiagramUrl         String   @default("")
  draftDiagrams           Json     @default("[]")
  draftContentStatus      String   @default("")
  draftMarkingScheme      String   @default("") @db.Text
  draftAnswerFormat       String   @default("") @db.Text
  draftRevisionChecklist  String[] @default([])
  draftUpdatedAt          DateTime?
  publishedAt             DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  contents     SeniorsTopicContent[]
  progress     SeniorsTopicProgress[]
  quizzes      SeniorsQuiz[]
  topicLinks   SeniorsAssignmentTopicLink[]
  aiThreads    SeniorsAiThread[]

  @@unique([tenantId, slug, academicYearId])
  @@index([tenantId, chapterId])
  @@index([tenantId, academicYearId])
  @@index([tenantId, contentStatus])
}

model SeniorsTopicContent {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  topicId        String
  topic          SeniorsTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   SeniorsAcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  contentType    String
  title          String
  body           String   @default("") @db.Text
  fileUrl        String   @default("")
  uploadedById   String?
  uploadedByName String   @default("")
  status         String   @default("published")
  bodyFormat     String   @default("html")
  publishedAt    DateTime?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, topicId])
  @@index([tenantId, contentType])
  @@index([tenantId, updatedAt])
}

model SeniorsMediaFile {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName  String   @default("")
  mimeType  String
  bytes     Bytes
  sizeBytes Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model SeniorsAssignment {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   SeniorsAcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  title          String
  description    String   @default("") @db.Text
  subjectName    String   @default("")
  chapterName    String   @default("")
  /// When set, only students in this class see the assignment. Null = school-wide.
  targetClassId  String?
  targetClass    SeniorsClass? @relation(fields: [targetClassId], references: [id], onDelete: SetNull)
  dueAt          DateTime
  questionCount  Int      @default(0)
  /// Teacher-attached files (PDF/images) for this assignment
  attachmentUrls String[] @default([])
  createdById    String?
  createdByName  String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topicLinks SeniorsAssignmentTopicLink[]
  submissions SeniorsAssignmentSubmission[]

  @@index([tenantId, dueAt])
  @@index([tenantId, targetClassId])
  @@index([tenantId, createdAt])
}

model SeniorsAssignmentTopicLink {
  id           String @id @default(cuid())
  assignmentId String
  assignment   SeniorsAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  topicId      String
  topic        SeniorsTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, topicId])
}

model SeniorsAssignmentSubmission {
  id           String   @id @default(cuid())
  tenantId     String
  assignmentId String
  assignment   SeniorsAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  status       String   @default("pending")
  answerText   String   @default("") @db.Text
  /// Student-uploaded files for this submission
  attachmentUrls String[] @default([])
  score        Float?
  feedback     String   @default("") @db.Text
  gradedAt     DateTime?
  gradedByName String   @default("")
  submittedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([assignmentId, studentId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

model SeniorsQuiz {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  topicId   String
  topic     SeniorsTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title     String
  questions Json     @default("[]")
  draftTitle     String   @default("")
  draftQuestions Json     @default("[]")
  status         String   @default("published")
  draftUpdatedAt DateTime?
  publishedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts SeniorsQuizAttempt[]

  @@index([tenantId, topicId])
  @@index([tenantId, createdAt])
}

model SeniorsQuizAttempt {
  id          String   @id @default(cuid())
  tenantId    String
  quizId      String
  quiz        SeniorsQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId   String
  score       Float?
  maxScore    Float?
  answers     Json     @default("{}")
  submittedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([tenantId, studentId, submittedAt])
  @@index([quizId, studentId])
}

model SeniorsExam {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  subjectName String @default("")
  examAt      DateTime
  /// When set, only students in this class see the exam. Null = school-wide.
  targetClassId String?
  targetClass   SeniorsClass? @relation(fields: [targetClassId], references: [id], onDelete: SetNull)
  className    String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, examAt])
  @@index([tenantId, targetClassId, examAt])
}

model SeniorsAnnouncement {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  icon      String   @default("megaphone")
  /// "school" = school-admin posts; "teacher" = teacher posts
  source    String   @default("teacher")
  /// "all" | "roles" | "people"
  audienceType   String @default("all")
  /// JSON string[] of student | teacher | parent
  audienceRoles  Json   @default("[\"student\",\"teacher\",\"parent\"]")
  /// JSON string[] of SeniorsClass ids
  targetClassIds Json   @default("[]")
  /// JSON string[] of PlatformUser ids for particular people
  targetUserIds  Json   @default("[]")
  publishedAt DateTime @default(now())
  createdByName String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, publishedAt])
  @@index([tenantId, source, publishedAt])
}

model SeniorsTeacherUpdate {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherName String
  message     String   @db.Text
  avatarUrl   String   @default("")
  publishedAt DateTime @default(now())

  @@index([tenantId, publishedAt])
}

model SeniorsAiThread {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  topicId   String?
  topic     SeniorsTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  SeniorsAiMessage[]

  @@index([tenantId, studentId, updatedAt])
  @@index([tenantId, topicId])
}

model SeniorsAiMessage {
  id        String   @id @default(cuid())
  threadId  String
  thread    SeniorsAiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String
  content   String   @db.Text
  sources   Json     @default("[]")
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

model SeniorsStudentGamification {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId      String   @unique
  student        PlatformUser @relation(fields: [studentId], references: [id], onDelete: Cascade)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate String   @default("")
  coins          Int      @default(0)
  totalCoins     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, studentId])
  @@index([tenantId, currentStreak])
  @@index([tenantId, coins])
}

model SeniorsGamificationEvent {
  id        String   @id @default(cuid())
  tenantId  String
  studentId String
  day       String
  kind      String
  coins     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([tenantId, studentId, day, kind])
  @@index([tenantId, studentId, day])
}

model SeniorsTopicProgress {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  topicId         String
  topic           SeniorsTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  studentId       String
  progressPercent Int      @default(0)
  isCompleted     Boolean  @default(false)
  lastVisitedAt   DateTime?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([topicId, studentId])
  @@index([tenantId, studentId])
}

model SeniorsParentChild {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentId  String
  parent    PlatformUser @relation("SeniorsParent", fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   PlatformUser @relation("SeniorsChild", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
  @@index([tenantId, parentId])
}

model SeniorsAttendance {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId  String
  student    PlatformUser @relation("SeniorsAttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  status     String   @default("present")
  markedById String?
  note       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, studentId, date])
  @@index([tenantId, studentId, date])
  @@index([tenantId, date])
}

model SeniorsLeaveRequest {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId    String
  parentId     String
  fromDate     DateTime @db.Date
  toDate       DateTime @db.Date
  reason       String   @db.Text
  status       String   @default("pending")
  adminNote    String   @default("") @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, parentId])
}

model SeniorsFeeRecord {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId   String
  title       String
  category    String   @default("tuition")
  amount      Float
  dueDate     DateTime?
  status      String   @default("due")
  paidAt      DateTime?
  receiptNo   String   @default("")
  paymentLink String   @default("")
  isOptional  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

model SeniorsTransportRoute {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  vehicleNo      String   @default("")
  driverName     String   @default("")
  driverPhone    String   @default("")
  stops          Json     @default("[]")
  feePaymentLink String   @default("")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  students SeniorsStudentTransport[]

  @@index([tenantId, isActive])
}

model SeniorsStudentTransport {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId  String   @unique
  routeId    String
  route      SeniorsTransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stopName   String   @default("")
  pickupTime String   @default("")
  updatedAt  DateTime @updatedAt

  @@index([tenantId, routeId])
}

model SeniorsTransportUpdateRequest {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId  String
  parentId   String
  routeId    String?
  stopName   String   @default("")
  note       String   @default("") @db.Text
  status     String   @default("pending")
  adminNote  String   @default("") @db.Text
  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, studentId])
}

model SeniorsServiceCatalog {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type         String
  academicYear String   @default("")
  title        String
  description  String   @default("") @db.Text
  items        Json     @default("[]")
  isOpen       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  selections SeniorsServiceSelection[]

  @@index([tenantId, type])
  @@index([tenantId, type, isOpen])
}

model SeniorsServiceSelection {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId   String
  parentId    String
  catalogId   String
  catalog     SeniorsServiceCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  type        String
  selections  Json     @default("[]")
  totalAmount Float    @default(0)
  status      String   @default("submitted")
  adminNote   String   @default("") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, studentId])
  @@index([tenantId, type])
  @@index([tenantId, status])
}

model SeniorsSchoolSettings {
  tenantId        String @id
  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schoolName      String @default("")
  logoUrl         String @default("")
  primaryColor    String @default("#2563EB")
  tagline         String @default("")
  markingScheme   String @default("") @db.Text
  answerFormat    String @default("") @db.Text
  academicCalendar Json  @default("[]")
  updatedAt       DateTime @updatedAt
}

model SeniorsAnalyticsEvent {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventType String
  userId    String?
  role      String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([tenantId, eventType])
  @@index([tenantId, createdAt])
  @@index([tenantId, userId])
  @@index([tenantId, role, createdAt])
}

model PlatformUser {
  id              String    @id
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName        String
  email           String
  passwordHash    String?
  source          String    @default("admin")
  phone           String    @default("")
  isInternational Boolean   @default(false)
  phoneVerified   Boolean   @default(false)
  emailVerified   Boolean   @default(false)
  userType        String
  joinedAt        DateTime
  lastLoginAt     DateTime?

  seniorsStudentProfile SeniorsStudentProfile?
  seniorsGamification   SeniorsStudentGamification?
  seniorsParentLinks    SeniorsParentChild[] @relation("SeniorsParent")
  seniorsChildLinks     SeniorsParentChild[] @relation("SeniorsChild")
  seniorsTeacherAssignments SeniorsTeacherAssignment[]
  seniorsPersonalTimetableSlots SeniorsPersonalTimetableSlot[]
  seniorsAttendanceRecords  SeniorsAttendance[] @relation("SeniorsAttendanceStudent")

  @@index([tenantId, userType])
}
